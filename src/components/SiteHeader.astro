---
/**
 * @file SiteHeader.astro
 * @brief 提供主页与资源页共享的站点身份和主要导航。
 */

interface Props {
    currentPage: 'home' | 'collection' | 'apps' | 'app-detail';
}

const { currentPage } = Astro.props;
const identityHref = currentPage === 'home' ? '#home' : '/';
---

<header class="site-nav" aria-label="主要导航">
    <a class="identity-mark" href={identityHref} aria-label="返回主页">
        <picture>
            <source srcset="/assets/images/avatar-96.webp" type="image/webp" />
            <img
                src="/assets/images/avatar.png"
                class="avatar"
                width="48"
                height="48"
                alt=""
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </picture>
        <span>Zzz-xz</span>
    </a>
    <nav class="nav-links" aria-label="主要链接">
        <a class="text-link" href="/collection/" aria-current={currentPage === 'collection' ? 'page' : undefined}>Collection</a>
        <a class="text-link" href="/apps/" aria-current={currentPage === 'apps' ? 'page' : currentPage === 'app-detail' ? 'location' : undefined}>Apps</a>
        <a
            class="text-link github-link"
            href="https://github.com/Zzz-xz"
            rel="external nofollow noopener noreferrer"
            target="_blank"
        >
            <span>GitHub</span>
            <span aria-hidden="true">↗</span>
        </a>
    </nav>
</header>
